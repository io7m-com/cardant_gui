                        <TextField fx:id="itemField" editable="false" layoutX="138.0" layoutY="10.0" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="32.0" styleClass="dataField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
