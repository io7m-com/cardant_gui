                        <Button fx:id="serialRemove" layoutX="10.0" layoutY="10.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onSerialRemoveSelected" prefHeight="32.0" prefWidth="32.0" HBox.hgrow="NEVER">
