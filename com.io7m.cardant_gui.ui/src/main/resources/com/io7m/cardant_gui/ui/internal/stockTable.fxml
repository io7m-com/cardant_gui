               <tooltip>
                  <Tooltip text="%cardant.tooltip.stock.add" />
               </tooltip>
            </Button>
            <Button fx:id="stockMove" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onStockMoveSelected" prefHeight="32.0" prefWidth="32.0">
